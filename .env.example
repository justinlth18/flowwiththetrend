# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Signs the desk login cookie. Use a long random string.
DESK_SESSION_SECRET=a_long_random_string
# The private registration link is /desk/register/THIS_VALUE. Share it only with people who should have an account.
DESK_INVITE_TOKEN=a_long_random_token
# Vercel sends this to the daily keepalive. Use any long random string.
CRON_SECRET=a_long_random_string

# Resend → API Keys. The notify address is the inbox that receives each brief.
RESEND_API_KEY=re_your_key
INQUIRY_NOTIFY_EMAIL=you@example.com
# Optional. Until a domain is verified, leave this unset and use onboarding@resend.dev.
# INQUIRY_FROM_EMAIL=Flow With The Trend <hello@yourdomain.com>
